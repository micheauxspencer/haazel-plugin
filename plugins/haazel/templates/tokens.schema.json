{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/micheauxspencer/haazel-plugin/templates/tokens.schema.json",
  "title": "Haazel Design Tokens",
  "description": "Machine source of truth for a haazel site's design system. Consumed by scripts/apply-tokens.ts in the scaffold, generated by the haazel-design-system skill. DESIGN_SYSTEM.md and DESIGN_SYSTEM.html are derived from this file.",
  "type": "object",
  "required": ["version", "meta", "colors", "typography", "shape", "spacing", "motion", "voice", "imagery"],
  "properties": {
    "version": { "const": 1 },
    "meta": {
      "type": "object",
      "required": ["name", "slug", "archetype", "colorScheme"],
      "properties": {
        "name": { "type": "string", "description": "Client/site display name" },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "description": "Kebab-case slug; becomes package.json name" },
        "domain": { "type": "string" },
        "archetype": { "enum": ["cinematic", "saas", "app", "leadgen", "commerce", "editorial"] },
        "colorScheme": { "enum": ["dark", "light", "dual"], "description": "dark: site is dark-only; light: light-only; dual: light default with .dark support" },
        "stylePreset": { "enum": ["cinematic", "minimalist", "brutalist", "luxury", "corporate", "creative", "ecommerce"], "description": "Optional GSAPProvider preset override; defaults from motion.policy" },
        "generator": { "type": "string" }
      }
    },
    "colors": {
      "type": "object",
      "required": ["semantic"],
      "properties": {
        "palette": {
          "type": "object",
          "description": "Named brand ramp with usage discipline; documented in DESIGN_SYSTEM.md",
          "additionalProperties": {
            "type": "object",
            "required": ["value"],
            "properties": {
              "value": { "$ref": "#/$defs/hex" },
              "role": { "type": "string" },
              "maxShare": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        },
        "brand": {
          "type": "object",
          "description": "Optional explicit overrides for brand.config.ts colors (else derived from semantic)",
          "properties": {
            "primary": { "$ref": "#/$defs/hex" },
            "primaryDark": { "$ref": "#/$defs/hex" },
            "primaryLight": { "$ref": "#/$defs/hex" },
            "secondary": { "$ref": "#/$defs/hex" },
            "accent": { "$ref": "#/$defs/hex" }
          }
        },
        "semantic": {
          "type": "object",
          "description": "Per-scheme semantic sets. dark required when colorScheme=dark; light required when light|dual.",
          "properties": {
            "dark": { "$ref": "#/$defs/semanticSet" },
            "light": { "$ref": "#/$defs/semanticSet" }
          }
        },
        "rules": { "type": "array", "items": { "type": "string" } }
      }
    },
    "typography": {
      "type": "object",
      "required": ["fonts", "scale"],
      "properties": {
        "fonts": {
          "type": "object",
          "required": ["display", "heading", "body", "mono"],
          "properties": {
            "display": { "$ref": "#/$defs/font" },
            "heading": { "$ref": "#/$defs/font" },
            "body": { "$ref": "#/$defs/font" },
            "mono": { "$ref": "#/$defs/font" }
          }
        },
        "scale": {
          "type": "object",
          "required": ["hero", "display", "heading", "body", "overline"],
          "additionalProperties": {
            "type": "object",
            "required": ["size"],
            "properties": {
              "size": { "type": "string", "description": "CSS size, clamp() encouraged" },
              "lineHeight": { "type": ["number", "string"] },
              "font": { "enum": ["display", "heading", "body", "mono"] },
              "weight": { "type": "number" },
              "tracking": { "type": "string" },
              "transform": { "type": "string" },
              "style": { "type": "string" }
            }
          }
        }
      }
    },
    "shape": {
      "type": "object",
      "required": ["radius"],
      "properties": {
        "radius": { "type": "string", "description": "Base --radius (e.g. \"0px\" heritage, \"0.75rem\" saas)" },
        "borderWidth": { "type": "string" },
        "hairline": { "type": "string", "description": "Full CSS border shorthand; defaults to a foreground color-mix hairline" }
      }
    },
    "spacing": {
      "type": "object",
      "required": ["sectionGap", "contentGap", "containerMax", "gutter"],
      "properties": {
        "grid": { "type": "number" },
        "sectionGap": { "type": "string" },
        "contentGap": { "type": "string" },
        "elementGap": { "type": "string" },
        "tightGap": { "type": "string" },
        "containerMax": { "type": "string" },
        "gutter": { "type": "string" }
      }
    },
    "motion": {
      "type": "object",
      "required": ["policy", "easing", "durations"],
      "properties": {
        "policy": {
          "enum": ["cinematic", "expressive", "restrained", "minimal"],
          "description": "cinematic: full scroll-scrub arsenal; expressive: reveals+ambient, no heavy pins; restrained: entrance reveals + micro-interactions only (SaaS default); minimal: transitions only (app/dashboard default)"
        },
        "easing": {
          "type": "object",
          "required": ["standard"],
          "properties": { "standard": { "type": "string" }, "exit": { "type": "string" } }
        },
        "durations": {
          "type": "object",
          "required": ["fast", "base", "slow", "reveal"],
          "additionalProperties": { "type": "string" }
        },
        "reducedMotion": { "enum": ["reduce", "off"], "description": "reduce: settled-state fallbacks (default); off: disable all animation site-wide" },
        "smoothScroll": { "type": "boolean" },
        "ambient": {
          "type": "object",
          "properties": {
            "cursorGlow": { "type": "boolean" },
            "noiseOverlay": {
              "type": "object",
              "properties": { "enabled": { "type": "boolean" }, "opacity": { "type": "number" } }
            }
          }
        },
        "bannedModules": { "type": "array", "items": { "type": "string" }, "description": "Component names forbidden for this site; QA greps for them" }
      }
    },
    "voice": {
      "type": "object",
      "required": ["tone", "adjectives", "bannedPhrases", "writingStyle"],
      "properties": {
        "tone": { "type": "array", "items": { "type": "string" } },
        "adjectives": { "type": "array", "items": { "type": "string" } },
        "bannedPhrases": { "type": "array", "items": { "type": "string" } },
        "writingStyle": { "type": "string" }
      }
    },
    "imagery": {
      "type": "object",
      "required": ["style"],
      "properties": {
        "style": { "enum": ["photorealistic", "illustration", "abstract", "editorial"] },
        "formulas": { "type": "object", "additionalProperties": { "type": "string" } },
        "subjects": { "type": "array", "items": { "type": "string" } },
        "lighting": { "type": "array", "items": { "type": "string" } },
        "cameras": { "type": "array", "items": { "type": "string" } },
        "lenses": { "type": "array", "items": { "type": "string" } },
        "grade": { "type": "string" },
        "avoid": { "type": "array", "items": { "type": "string" } },
        "colorTemperature": { "type": "string" }
      }
    }
  },
  "$defs": {
    "hex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$" },
    "font": {
      "type": "object",
      "required": ["family", "fallback"],
      "properties": {
        "family": { "type": "string", "description": "Exact Google Fonts family name" },
        "provider": { "enum": ["google", "local"] },
        "weights": { "type": "array", "items": { "type": "number" } },
        "styles": { "type": "array", "items": { "enum": ["normal", "italic"] } },
        "axes": {
          "type": "object",
          "additionalProperties": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }
        },
        "fallback": { "type": "string", "description": "CSS fallback stack (no leading comma)" }
      }
    },
    "semanticSet": {
      "type": "object",
      "required": [
        "background", "foreground", "card", "cardForeground", "popover", "popoverForeground",
        "primary", "primaryForeground", "secondary", "secondaryForeground", "muted",
        "mutedForeground", "accent", "accentForeground", "destructive", "border", "input", "ring"
      ],
      "additionalProperties": { "$ref": "#/$defs/hex" },
      "description": "18 semantic colors, hex (#RRGGBB or #RRGGBBAA); converted to oklch by apply-tokens"
    }
  }
}
